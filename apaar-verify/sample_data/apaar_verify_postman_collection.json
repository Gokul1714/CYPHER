              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/intake?institutionId={{dietInstId}}",
              "host": ["{{baseUrl}}"],
              "path": ["intake"],
              "query": [{ "key": "institutionId", "value": "{{dietInstId}}" }]
